# PostgreSQL Configuration (Optional if using SQLite)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=english_assitance

DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/english_assitance

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Get 100% free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: LLM Model Provider (auto, gemini, local)
LLM_PROVIDER=auto

# Optional: LLM Model Choice (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

